# ==============================================================================
# AWAAYA - FICHIER D'EXEMPLE DE CONFIGURATION D'ENVIRONNEMENT
# Copiez ce fichier vers .env ou .env.local et renseignez vos valeurs réelles.
# ==============================================================================

# 1. APPLICATION & SERVEUR
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. BASE DE DONNÉES (POSTGRESQL / PRISMA)
DATABASE_URL="postgresql://username:password@localhost:5432/awaaya_db?schema=public"

# 3. SÉCURITÉ & AUTHENTIFICATION
NEXTAUTH_SECRET="your-super-secret-jwt-key-here"
NEXTAUTH_URL="http://localhost:3000"

# 4. CONFIGURATION PUBLIQUE DE MARQUE (AWAAYA)
NEXT_PUBLIC_SITE_NAME="AWAAYA"
NEXT_PUBLIC_SITE_TAGLINE="Croître en Afrique, de façon rentable et durable"
NEXT_PUBLIC_CONTACT_EMAIL="contact@awaaya.ci"
NEXT_PUBLIC_CONTACT_PHONE="+225 05 45 45 52 45"
NEXT_PUBLIC_OFFICE_ADDRESS="Cocody, Riviera Bonoumin, Abidjan, Côte d'Ivoire"

# 5. EMAILS & NOTIFICATIONS (OPTIONNEL)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="contact@awaaya.ci"
SMTP_PASSWORD=""
SMTP_FROM="Cabinet AWAAYA <contact@awaaya.ci>"

